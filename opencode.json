  "mcp": {
    // "exa": {
    //   "type": "remote",
    //   "url": "https://mcp.exa.ai/mcp",
    //   "enabled": true
    // },
    "github": {
      "enabled": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
      },
    },
    "zai-vision": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server"],
      "environment": {
        "Z_AI_API_KEY": "$ZAI_API_KEY",
        "Z_AI_MODE": "ZAI",
      },
    },
    "zai-web-reader": {
      "enabled": false,
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer $ZAI_API_KEY",
      },
    },
    "brave-search": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server", "--transport", "http"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}",
      }
    },
    "zai-web-search-prime": {
      "enabled": false,
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer $ZAI_API_KEY",
      },
    },
    "godot": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "godot-mcp"],
    },
    "gopls": {
      "enabled": false,
      "type": "local",
      "command": ["/Volumes/K/Code/go/bin/gopls", "mcp"],
    },
    "gh-grep": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "grep-mcp"],
    },
    "deepwiki": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.deepwiki.com/sse",
    },
    "context7": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "$CONTEXT7_API_KEY",
      ],
    },
    "search-server": {
      "enabled": false,
      "type": "local",
      "command": ["mcp-search-server"],
    },
    "basic-memory": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "basic-memory", "mcp", "--transport", "stdio"],
    },
    "emacs-mcp": {
      "enabled": false,
      "type": "local",
      "command": ["~/.emacs.d/emacs-mcp-stdio.sh"],
    },
    "blender": {
      "enabled": false,
      "type": "local",
      "command": ["uvx", "blender-mcp"],
    },
    "beads": {
      "enabled": false,
      "type": "local",
      "command": ["beads-mcp"],
    },
    "sequential-thinking": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking",
      ],
    },
    "structured-memory": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "@nmeierpolys/mcp-structured-memory"],
    },
    "clear-thought": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "@waldzellai/clear-thought"],
    },
    "calculator": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "@wrtnlabs/calculator-mcp@latest"],
    },
  },
}
