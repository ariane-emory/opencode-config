{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [
    "openrouter",
    // "opencode",
    // "opencode-go",
    "github-copilot",
    "github-copilot-enterprise",
    "github-models",
    "mistral",
  ],
  "default_agent": "plan",
  "model": "zai-coding-plan/glm-5.1k",
  // "model": "kimi-for-coding-oauth/kimi-for-coding",
  "small_model": "kimi-for-coding-oauth/kimi-for-coding",
  "snapshot": 1,
  "formatter": false,
  "autoupdate": false,
  "lsp": false,
  "share": "disabled",
  "username": "Ariane Emory",
  "experimental": {
    "continue_loop_on_deny": false,
    "cache_command_markdown_files": false,
    "context_compaction_threshold": 100,
    "disable_paste_summary": true,
    "enable_exa": true,
    "max_prompt_input_lines": 20,
    "messages_limit": "none",
    "openTelemetry": false,
    "plan_mode": true,
    "session_list_limit": "none",
  },
  "plugin": [
    "@ariane-emory/must-have-plugin@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-kimi-full@latest",
  ],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "plan": {
      "color": "#00aa00",
    },
    "build": {
      "color": "#bb4400",
    },
    "explore": {
      "model": "closedrouter-openai-compatible/deepseek-v4-flash", 
      "disable": false,
    },
    "general": {
      "model": "kimi-for-coding-oauth/kimi-for-coding",
      "disable": true
    }
  },
