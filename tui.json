{
  "$schema": "https://opencode.ai/tui.json",
  "keybinds": {
    "leader": "f1",
    "display_thinking": "alt+shift+t",
    "command_list": "alt+x",
    "history_previous": "alt+p",
    "history_next": "alt+n",
    "messages_copy": "ctrl+w",
    "messages_last_user": "ctrl+l",
    "messages_page_up": "pageup",
    "messages_page_down": "pagedown",
    "messages_previous": "none",
    "messages_next": "none",
    "model_cycle_favorite": "ctrl+k",
    "model_cycle_favorite_reverse": "ctrl+j",
    "model_cycle_recent": "alt+k",
    "model_cycle_recent_reverse": "alt+j",
    "model_list": "alt+m",
    "session_child_cycle": "ctrl+right",
    "session_child_cycle_reverse": "ctrl+left",
    "session_child_first": "alt+h",
    "session_parent": "ctrl+h",
    "session_fork": "ctrl+f",
    "session_list": "ctrl+s",
    "session_new": "alt+n",
    "session_rename": "ctrl+r",
    "session_timeline": "ctrl+g",
    "sidebar_toggle": "ctrl+b",
    "theme_list": "alt+t",
    "tool_details": "ctrl+t",
  },
  "diff_style": "stacked",
}
