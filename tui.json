    "/doom-loop": "ctrl+alt+l",
    "/fake_command": "alt+f",
    "/gco": "ctrl+alt+g",
    "/gcod": "ctrl+alt+d",
    // "/haha": "ctrl+alt+j",
    "/individual-todos": "ctrl+alt+i",
    "/note-dir": "ctrl+alt+n",
    "/regression": "ctrl+alt+z", 
    "/todo-reminder": "alt+shift+t",
