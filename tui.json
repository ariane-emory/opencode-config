    "/update-dev--glm-5.2": "ctrl+alt+u",
    "/update-dev--kimi-k2p6": "ctrl+alt+shift+u",
    "/update-dev--kimi-oauth": "alt+shift+u",
    "/update-dev--cr-gpt-5.4": "ctrl+shift+u",

    // updated remotely:
    "/updated-remotely--glm-5.2": "ctrl+shift+r",
    "/updated-remotely--kimi-k2p6": "ctrl+alt+shift+b",
    "/updated-remotely--kimi-oauth": "alt+shift+r",
    "/updated-remotely--cr-gpt-5.4": "ctrl+shift+r",
    
    // build local baseone:
    "/build-baseone-local--glm-5.2": "ctrl+shift+b",
    "/build-baseone-local--kimi-k2p6": "ctrl+alt+shift+b",
    "/build-baseone-local--kimi-oauth": "alt+shift+b",
    "/build-baseone-local--cr-gpt-5.4": "ctrl+shift+b",

    // misc:
    "/carry-on": "alt+shift+c",
