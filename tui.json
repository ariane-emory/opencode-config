    "which_key_page_down": "ctrl+alt+pagedown", // def
    "which_key_home": "ctrl+alt+home", // def
    "which_key_end": "ctrl+alt+end", // def

    "session_child_toggle": "alt+h",
    "session_continue": "ctrl+space",
    
    // "session_child_first": "alt+h",
    // "session_parent": "ctrl+h",

    // commit and push:
    "/commit-and-push--glm-5.2": "ctrl+alt+p",
    "/commit-and-push--kimi-k2p6": "ctrl+alt+shift+p",
    "/commit-and-push--kimi-oauth": "alt+shift+p",
    "/commit-and-push--glm-5-turbo": "ctrl+shift+p",

    // hard sync:
    "/hard-sync-all-remotes--glm-5.2": "ctrl+alt+h",
    "/hard-sync-all-remotes--kimi-k2p6": "ctrl+alt+shift+h",
    "/hard-sync-all-remotes--kimi-oauth": "alt+shift+h",
    "/hard-sync-all-remotes--cg3f": "ctrl+shift+h",
    "/hard-sync-all-remotes--cr-gpt-5.5": "<leader>ctrl+alt+h",

    // integrate:
    "/integrate-branches--glm-5.2": "ctrl+alt+q",
    "/integrate-branches--kimi-k2p6": "ctrl+alt+shift+q",
    "/integrate-branches--kimi-oauth": "alt+shift+q",
    "/integrate-branches--test": "ctrl+shift+q",
    //"/integrate-branches--cr-gpt-5.4": "ctrl+shift+q",

    "/haha": "ctrl+alt+j",
        
    // merge dev into branch:
    "/merge-dev-into-branch-by-pr-resolve-conflicts-and-push--glm-5.2": "ctrl+alt+m",
    "/merge-dev-into-branch-by-pr-resolve-conflicts-and-push--kimi-k2p6": "ctrl+alt+shift+m",
    "/merge-dev-into-branch-by-pr-resolve-conflicts-and-push--kimi-oauth": "alt+shift+m",
    "/merge-dev-into-branch-by-pr-resolve-conflicts-and-push--test": "ctrl+shift+m",
