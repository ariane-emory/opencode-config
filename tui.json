    // merge upstream dev into branch:
    // "/merge-upstream-dev-into-branch-by-pr-resolve-conflicts-and-push--kimi-oauth": "<leader>ctrl+alt+m",
    // "/merge-upstream-dev-into-branch-by-pr-resolve-conflicts-and-push--kimi-k2p6": "<leader>ctrl+alt+shift+m",
    // "/merge-upstream-dev-into-branch-by-pr-resolve-conflicts-and-push--glm-5.2": "<leader>alt+shift+m",
    // "/merge-upstream-dev-into-branch-by-pr-resolve-conflicts-and-push--cr-gpt-5.4": "<leader>ctrl+shift+m",
    
