    "history_previous": "alt+p",
    "history_next": "alt+n",

    "dialog.select.prev": "up,ctrl+p", // def
    "dialog.select.next": "down,ctrl+n", // def
    "dialog.select.page_up": "pageup", // def
    "dialog.select.page_down": "pagedown", // def
    "dialog.select.home": "home", // def
    "dialog.select.end": "end", // def
    "dialog.select.submit": "return", // def
