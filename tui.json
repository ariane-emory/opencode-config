    "prompt.autocomplete.next": "down,ctrl+n", // def
    "prompt.autocomplete.hide": "escape", // def
    "prompt.autocomplete.select": "return", // def
    "prompt.autocomplete.complete": "tab", // def
    "permission.prompt.fullscreen": "ctrl+f", // def
    "plugins.toggle": "space", // def
    "dialog.plugins.install": "shift+i", // def

    "terminal_suspend": "none", 
    "terminal_title_toggle": "none", // def
    "tips_toggle": "<leader>h", // def
    "plugin_manager": "none", // def
    "plugin_install": "none", // def

    "which_key_toggle": "ctrl+alt+k", // def
    "which_key_layout_toggle": "ctrl+alt+shift+k", // def
    "which_key_pending_toggle": "ctrl+alt+shift+p", // def
